{
  "name": "openchamber-shortcuts",
  "version": "0.2.0",
  "description": "自定义快捷按钮：一键把常用命令/代码片段提交到会话（只有状态区）",
  "private": true,
  "type": "module",
  "license": "MIT",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.3.3"
    },
    "contributes": {
      "panel": {
        "id": "shortcuts",
        "name": "快捷命令",
        "icon": "flash"
      },
      "capabilities": [
        "prompt",
        "files"
      ],
      "statusSection": {
        "entry": "status/index.html",
        "title": "快捷命令",
        "height": 120
      },
      "filesystem": [
        "~/.config/opencode/snippet",
        "~/.config/opencode/snippet/**",
        "~/.config/opencode/command",
        "~/.config/opencode/command/**",
        "~/.config/opencode/commands",
        "~/.config/opencode/commands/**"
      ]
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.3.3",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.2"
  }
}
